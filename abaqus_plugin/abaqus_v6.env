import os
def onCaeStartup():

    import pathlib
    mcp_home = os.environ.get("ABAQUS_MCP_HOME")
    if mcp_home:
        mcp_home = pathlib.Path(mcp_home.strip())
    else:
        mcp_home = pathlib.Path.home() / ".abaqus_mcp"

    mcp_plugin = mcp_home / "abaqus_plugin" / "plugin_main.py"
    if mcp_plugin.exists():
        import __main__
        __main__.__dict__['__file__'] = str(mcp_plugin)
        exec(mcp_plugin.read_text(encoding='utf-8'), __main__.__dict__)